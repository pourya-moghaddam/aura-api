# Copy to .env and fill in. .env is gitignored - never commit real values.
#
#   cp .env.example .env

# --- Profile -----------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
TAG=dev

# --- PostgreSQL --------------------------------------------------------------------------------
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aura
POSTGRES_PORT=5432

# --- Redis / Kafka / Elasticsearch / MinIO -----------------------------------------------------
REDIS_PORT=6379
KAFKA_HOST_PORT=29092
ELASTICSEARCH_PORT=9200
ELASTIC_PASSWORD=change-me
MINIO_ROOT_USER=aura
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Gateway -----------------------------------------------------------------------------------
GATEWAY_PORT=8080

# --- JWT signing ------------------------------------------------------------------------------
# Generate with: ./docker/generate-signing-key.sh
# Leave empty in dev and auth-service generates an ephemeral keypair at startup (tokens then do
# not survive a restart). Under the prod profile, startup fails if these are unset.
AURA_TOKEN_ISSUER=http://auth-service:8081
AURA_AUTH_TOKEN_RSA_PRIVATE_KEY_PEM=
AURA_AUTH_TOKEN_RSA_PUBLIC_KEY_PEM=

# --- Bootstrap super admin ---------------------------------------------------------------------
# Created on first startup if no SUPER_ADMIN exists yet.
AURA_SUPERADMIN_PHONE=+989000000000
AURA_SUPERADMIN_PASSWORD=

# --- SMS provider (sms.ir) ---------------------------------------------------------------------
# The key previously committed in notification-service/application.yml was live. Rotate it at the
# provider before using this.
# Leave a value here even in dev. An empty assignment is NOT the same as an unset variable:
# it supplies an empty string, which defeats the `${VAR:default}` fallback in application.yml
# and fails to bind to a numeric property, crash-looping notification-service on startup.
SMS_IR_API_KEY=
SMS_IR_OTP_TEMPLATE_ID=823095
