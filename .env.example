# Copy to .env and fill in. .env is gitignored - never commit real values.
#
#   cp .env.example .env

# --- Profile -----------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
TAG=dev

# --- PostgreSQL --------------------------------------------------------------------------------
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aura
POSTGRES_PORT=5432

# --- Redis / Kafka / Elasticsearch / MinIO -----------------------------------------------------
REDIS_PORT=6379
KAFKA_HOST_PORT=29092
ELASTICSEARCH_PORT=9200
ELASTIC_PASSWORD=change-me
MINIO_ROOT_USER=aura
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Gateway -----------------------------------------------------------------------------------
GATEWAY_PORT=8080

# --- JWT signing ------------------------------------------------------------------------------
# Generate with: ./docker/generate-signing-key.sh
# Leave empty in dev and auth-service generates an ephemeral keypair at startup (tokens then do
# not survive a restart). Under the prod profile, startup fails if these are unset.
AURA_TOKEN_ISSUER=http://auth-service:8081
AURA_AUTH_TOKEN_RSA_PRIVATE_KEY_PEM=
AURA_AUTH_TOKEN_RSA_PUBLIC_KEY_PEM=

# --- Bootstrap super admin ---------------------------------------------------------------------
# Created on first startup if no SUPER_ADMIN exists yet.
AURA_SUPERADMIN_PHONE=+989000000000
AURA_SUPERADMIN_PASSWORD=

# --- SMS provider (sms.ir) ---------------------------------------------------------------------
# The key previously committed in notification-service/application.yml was live. Rotate it at the
# provider before using this.
# Leave a value here even in dev. An empty assignment is NOT the same as an unset variable:
# it supplies an empty string, which defeats the `${VAR:default}` fallback in application.yml
# and fails to bind to a numeric property, crash-looping notification-service on startup.
SMS_IR_API_KEY=
SMS_IR_OTP_TEMPLATE_ID=823095
# mock accepts every message and sends nothing. compose.prod.yaml refuses to start without this
# set, because a supplied key with the mode left on mock means a perfectly good credential sits
# unused while shoppers wait for codes that never arrive.
AURA_SMS_MODE=mock
# The sender line free-text order-status messages go out on. Templates use the provider's shared
# line, so this is only needed once real order notifications are being sent.
SMS_IR_LINE_NUMBER=

# --- One-time codes ----------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY. Empty by default, and it must stay empty anywhere real.
#
# Codes are hashed at rest and deliberately never logged, so with the SMS gateway in mock mode
# there is otherwise no way to finish a sign-in locally. Setting this makes the value below an
# accepted answer *in addition to* the real code - a code must still have been requested and still
# be unexpired, so the flow being exercised is the real one.
#
# A fixed code means every account is reachable by anyone who knows a phone number. auth-service
# refuses to start with this set under the prod profile, and warns loudly everywhere else.
AURA_OTP_DEV_CODE=

# --- Payments (Zarinpal) -----------------------------------------------------------------------
# mock settles every payment locally so the flow can be exercised without a merchant account.
# It is also the most dangerous default in the codebase: left on in production it marks every
# order paid and commits the stock for nothing. compose.prod.yaml requires all four.
AURA_ZARINPAL_MODE=mock
AURA_ZARINPAL_MERCHANT_ID=
AURA_ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
# Opened in the shopper's browser, so both are public addresses rather than container ones.
AURA_ZARINPAL_CALLBACK_URL=http://localhost:8080/api/orders/payments/callback
AURA_STOREFRONT_PAYMENT_RESULT_URL=http://localhost:3000/checkout/result

# --- Media scanning ----------------------------------------------------------------------------
# "none" accepts every upload unscanned. A shop that lets sellers upload files serves them back to
# shoppers, so this is a malware distribution channel until a scanner sits in front of it.
MEDIA_SCAN_PROVIDER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Search ------------------------------------------------------------------------------------
# Blank in dev, where Elasticsearch runs with security off. Production turns xpack.security on and
# needs these; without them every call is a 401 and search returns nothing at all.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- Object storage ----------------------------------------------------------------------------
# What goes into presigned URLs. "minio" resolves inside the Docker network and nowhere else, so a
# container address here breaks every product image in a browser.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# --- Observability -----------------------------------------------------------------------------
# Grafana is anonymous-viewer in dev. compose.prod.yaml turns that off and requires a password.
GRAFANA_PASSWORD=admin

# Shared secret for service-to-service calls on /api/internal/**. Generate with:
#   openssl rand -hex 32
AURA_INTERNAL_API_KEY=
